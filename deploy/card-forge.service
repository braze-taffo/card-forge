# systemd 服务单元示例：/etc/systemd/system/card-forge.service
# 安装：
#   sudo cp card-forge.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now card-forge
[Unit]
Description=Card Forge (锻卡炉) - AI character card creation web app
After=network.target

[Service]
Type=simple
# 按实际部署路径修改
WorkingDirectory=/opt/card-forge/server
ExecStart=/usr/bin/node index.mjs
Restart=on-failure
RestartSec=3
# 配置也可用环境变量注入（覆盖 config.json）
# Environment=FREE_BASE_URL=https://gw.example.com/v1
# Environment=FREE_API_KEY=sk-xxx
# Environment=FREE_MODEL=glm-4.7
# Environment=DAILY_REQUESTS_PER_IP=30
User=www-data
Group=www-data
# 加固
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/card-forge/server/data

[Install]
WantedBy=multi-user.target
